{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "gen/**", "generated/**"],
      // O Turbo roda as tasks com env **filtrado**. O `prisma generate` do
      // @repo/database exige `DATABASE_URL` no config (não conecta, só valida),
      // e sem esta linha ele não a enxerga — localmente passa despercebido
      // porque o `prisma.config.ts` lê o `.env` do disco, mas dentro do
      // container (sem `.env`) o build quebra.
      //
      // `passThroughEnv` e não `env`: o valor não muda o cliente gerado, então
      // não deve fazer parte da chave de cache.
      "passThroughEnv": ["DATABASE_URL"]
    },
    "//#format-and-lint": {},
    "//#format-and-lint:fix": { "cache": false },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      // O Turbo roda as tasks com um env **filtrado**: variável não declarada
      // aqui simplesmente não chega no processo. Sem esta linha, o
      // `TEST_DATABASE_URL` de `pnpm test:db` se perde e os `*.int.test.ts` se
      // auto-pulam — a suíte fica verde sem ter tocado no banco.
      // Declarar também faz parte da chave de cache, que é o correto: rodar
      // com e sem banco são execuções diferentes.
      "env": ["TEST_DATABASE_URL", "TEST_REDIS_URL", "DATABASE_URL", "CI"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "env": ["TEST_DATABASE_URL", "TEST_REDIS_URL", "DATABASE_URL", "CI"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"],
      "env": ["TEST_DATABASE_URL", "TEST_REDIS_URL", "DATABASE_URL", "CI"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
