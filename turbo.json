{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "gen/**", "generated/**"]
    },
    "//#format-and-lint": {},
    "//#format-and-lint:fix": { "cache": false },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
