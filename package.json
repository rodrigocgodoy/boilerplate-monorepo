{
  "name": "boilerplate-monorepo",
  "private": true,
  "prisma": {
    "schema": "packages/database/prisma/schema.prisma"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch --concurrency 20",
    "test:coverage": "turbo run test:coverage",
    "test:db": "tsx scripts/test-db.ts pnpm turbo run test",
    "test:db:coverage": "tsx scripts/test-db.ts pnpm turbo run test:coverage",
    "test:e2e": "turbo run build --filter=@repo/api --filter=@repo/api-client && tsx scripts/test-db.ts pnpm --filter @repo/app test:e2e",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "dep-up": "docker compose up -d",
    "dep-down": "docker compose down --remove-orphans",
    "dep-logs": "docker compose logs",
    "dep-restart": "docker compose restart",
    "db:generate": "pnpm --filter @repo/database generate",
    "db:migrate": "pnpm --filter @repo/database dev",
    "db:seed": "pnpm --filter @repo/database seed",
    "db:studio": "pnpm --filter @repo/database studio",
    "admin:create": "pnpm --filter @repo/api admin:create",
    "email:dev": "pnpm --filter @repo/emails email:dev",
    "worker": "pnpm --filter @repo/api worker",
    "auth:generate": "pnpm --filter @repo/api auth:generate",
    "openapi": "pnpm --filter @repo/api exec tsx src/scripts/generate-openapi.ts",
    "api-client": "pnpm --filter @repo/api-client build",
    "test:e2e:smoke": "turbo run build --filter=@repo/api-client && pnpm --filter @repo/app test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@repo/biome-config": "workspace:*",
    "@types/node": "^20.18.0",
    "@vitest/coverage-v8": "3.2.4",
    "prisma": "latest",
    "tsx": "^4.19.1",
    "turbo": "^2.7.6"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.10.0",
    "pnpm": ">=10.32.0"
  },
  "pnpm": {
    "overrides": {
      "@types/pg": "8.18.0",
      "vitest": "3.2.4"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
