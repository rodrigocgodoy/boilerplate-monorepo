
generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// Modelos do Better Auth
//
// Gerados/atualizados por `pnpm auth:generate` a partir da config em
// apps/api/src/modules/better-auth/configs.ts. Ao adicionar plugins
// (admin, organization, 2FA...) ou campos extras, rode auth:generate
// e depois `pnpm db:migrate`.
// ──────────────────────────────────────────────

model Users {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Sessions[]
  accounts      Accounts[]
  // Back-relations dos models de organização (Better Auth)
  teammembers   TeamMember[]
  members       Member[]
  invitations   Invitation[]

  // Plugin `admin` (RBAC de plataforma): role de sistema + ban.
  role       String?
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  @@map("users")
}

model Sessions {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  users     Users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  activeOrganizationId String? @db.Uuid
  activeTeamId         String? @db.Uuid

  impersonatedBy String?

  @@index([userId])
  @@map("sessions")
}

model Accounts {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  userId                String    @db.Uuid
  users                 Users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verifications {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
  @@index([identifier])
}

// ──────────────────────────────────────────────
// Modelos da aplicação
//
// Ficam FORA do escopo do `pnpm auth:generate` (que só gerencia os modelos do
// Better Auth acima). Por isso `userId` é uma coluna indexada simples, sem
// relação formal com `Users` — assim o CLI do Better Auth não remove o campo
// ao regenerar o schema. Espelha o estado das cobranças do AbacatePay
// localmente; a fonte da verdade do pagamento é o webhook.
// ──────────────────────────────────────────────

model Payments {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// id da cobrança no AbacatePay (pixQrCode.id ou billing.id)
  externalId     String         @unique
  /// "PIX_QRCODE" (transparente) | "BILLING" (PIX+CARD) | "SUBSCRIPTION" (recorrente)
  kind           String
  /// PENDING | PAID | EXPIRED | CANCELLED | REFUNDED
  status         String         @default("PENDING")
  /// valor em centavos
  amount         Int
  /// PIX | CARD (quando aplicável)
  method         String?
  description    String?
  /// copia-e-cola do PIX (apenas para PIX_QRCODE)
  brCode         String?
  /// URL de checkout hospedado (apenas para BILLING)
  url            String?
  /// usuário dono da cobrança (sem relação formal; ver nota acima)
  userId         String?        @db.Uuid
  /// vínculo opcional com a assinatura que originou a cobrança
  subscriptionId String?        @db.Uuid
  subscription   Subscriptions? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  /// payload bruto útil para auditoria/debug
  metadata       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId])
  @@index([status])
  @@index([subscriptionId])
  @@map("payments")
}

/// Catálogo de planos. Cada plano mapeia para um PRODUTO no AbacatePay criado
/// com um `cycle` (a recorrência nativa v2 cobra a partir do produto). Guarde o
/// id do produto (`prod_...`) em `externalProductId`.

model Plans {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// identificador estável usado no código/URL (ex.: "pro-monthly")
  slug              String          @unique
  name              String
  description       String?
  /// preço por ciclo, em centavos
  priceCents        Int
  currency          String          @default("BRL")
  /// WEEKLY | MONTHLY | SEMIANNUALLY | ANNUALLY
  interval          String          @default("MONTHLY")
  /// dias de trial (0 = sem trial)
  trialDays         Int             @default(0)
  /// id do produto correspondente no AbacatePay (prod_...)
  externalProductId String?
  /// limites/flags do plano (ex.: { "seats": 5, "apiCalls": 10000 })
  features          Json?
  active            Boolean         @default(true)
  sortOrder         Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  subscriptions     Subscriptions[]

  @@map("plans")
}

/// Assinatura de um dono (hoje sempre USER; `ownerType` deixa pronto para
/// ORGANIZATION quando o plugin organization for habilitado). O estado é
/// dirigido pelos webhooks do AbacatePay (subscription.*).

model Subscriptions {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// dono da assinatura (id do Users hoje; sem relação formal — ver nota acima)
  ownerId            String     @db.Uuid
  /// USER | ORGANIZATION
  ownerType          String     @default("USER")
  planId             String     @db.Uuid
  plan               Plans      @relation(fields: [planId], references: [id])
  /// id da assinatura no AbacatePay (subs_...)
  externalId         String?    @unique
  /// INCOMPLETE | TRIALING | ACTIVE | PAST_DUE | CANCELLED | EXPIRED
  status             String     @default("INCOMPLETE")
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean    @default(false)
  canceledAt         DateTime?
  trialEndsAt        DateTime?
  metadata           Json?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  payments           Payments[]

  @@index([ownerId, ownerType])
  @@index([status])
  @@map("subscriptions")
}

/// Contadores de uso por organização para entitlements/limites por plano (#7).
/// Cada linha acumula uma métrica medida (ex.: "apiCalls") dentro de um período
/// (`period` = chave mensal "YYYY-MM"). Virar o mês cria uma nova linha — reset
/// implícito, sem job de reset. Métricas de contagem viva (ex.: "seats") não
/// usam esta tabela; são contadas direto na fonte (Member).

model UsageCounters {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// organização dona do contador (org ativa da sessão)
  organizationId String   @db.Uuid
  /// nome da métrica medida (ex.: "apiCalls")
  metric         String
  /// chave do período de reset (mensal: "YYYY-MM")
  period         String
  /// quantidade consumida no período
  used           Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, metric, period])
  @@index([organizationId])
  @@map("usage_counters")
}

/// Trilha de auditoria (#8): ações sensíveis (mudou role, removeu membro,
/// cancelou assinatura…). Escopo por organização quando aplicável. Sem relação
/// formal com Users/Organization (mesma nota dos modelos da app) — `actorId` e
/// `organizationId` são colunas indexadas. Registro best-effort: falha ao
/// gravar nunca quebra a ação.

model AuditLogs {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// quem executou (id do Users)
  actorId        String?  @db.Uuid
  /// ação (ex.: "member.remove", "subscription.cancel")
  action         String
  /// organização no escopo da ação (quando aplicável)
  organizationId String?  @db.Uuid
  /// tipo do alvo (ex.: "member", "subscription", "team")
  targetType     String?
  /// id do alvo (memberId, email, subscriptionId…)
  targetId       String?
  /// contexto adicional (corpo da ação, status anterior/novo…)
  metadata       Json?
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([actorId])
  @@map("audit_logs")
}

/// Chaves de API para acesso programático (#10), com escopo por organização.
/// O token completo (`bk_…`) só é mostrado uma vez na criação; guardamos apenas
/// o hash SHA-256 e um prefixo visível para lookup/UI. `scopes` é um array de
/// permissões (Json); null = sem restrição além do escopo da org.

model ApiKeys {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// rótulo amigável definido pelo dono
  name           String
  /// prefixo visível do token (ex.: "bk_a1b2c3d4") — único, usado no lookup
  prefix         String    @unique
  /// hash SHA-256 (hex) do token completo — nunca guardamos o token em claro
  keyHash        String
  /// organização dona da chave
  organizationId String    @db.Uuid
  /// usuário que criou a chave
  userId         String    @db.Uuid
  /// escopos/permissões (array de strings); null = sem restrição extra
  scopes         Json?
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
  @@map("api_keys")
}

// ──────────────────────────────────────────────
// Modelos do plugin Organization do Better Auth.
// Gerados por `pnpm auth:generate`; ajustados para o padrão @db.Uuid +
// gen_random_uuid() do projeto (generateId: false → o banco gera o id).
// Ao rodar auth:generate de novo, reaplique @db.Uuid nos ids/FKs.
// ──────────────────────────────────────────────

model Organization {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  slug        String
  logo        String?
  createdAt   DateTime     @default(now())
  metadata    String?
  teams       Team[]
  members     Member[]
  invitations Invitation[]

  @@unique([slug])
  @@map("organization")
}

model Team {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime?    @updatedAt
  teammembers    TeamMember[]

  @@index([organizationId])
  @@map("team")
}

model TeamMember {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId    String    @db.Uuid
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String    @db.Uuid
  users     Users     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime? @default(now())

  @@index([teamId])
  @@index([userId])
  @@map("teamMember")
}

model Member {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @db.Uuid
  users          Users        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  teamId         String?      @db.Uuid
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String       @db.Uuid
  users          Users        @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}
