    "@sentry/react": "^10.56.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-router": "^1.159.4",
    "better-auth": "^1.5.4",
    "i18next": "^24.2.0",
    "i18next-browser-languagedetector": "^8.0.4",
    "lucide-react": "^0.563.0",
    "posthog-js": "^1.379.1",
