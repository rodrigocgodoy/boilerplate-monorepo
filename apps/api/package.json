{
  "name": "@repo/api",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "tsx --enable-source-maps --watch src/index.ts | pino-pretty",
    "worker": "tsx --enable-source-maps --watch src/worker.ts | pino-pretty",
    "build": "tsc && tsc-alias && tsc -p tsconfig.test.json",
    "start": "node --import ./dist/instrument.js dist/index.js",
    "start:worker": "node --import ./dist/instrument.js dist/worker.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "auth:generate": "npx @better-auth/cli generate --config ./src/utils/auth.ts --output ../../packages/database/prisma/schema.prisma --yes",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1061.0",
    "@aws-sdk/s3-presigned-post": "^3.1061.0",
    "@bull-board/api": "^6.21.3",
    "@bull-board/fastify": "^6.21.3",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/swagger": "^9.6.1",
    "@repo/database": "workspace:*",
    "@repo/emails": "workspace:*",
    "@repo/env": "workspace:*",
    "@repo/i18n": "workspace:*",
    "@repo/jobs": "workspace:*",
    "@repo/utils": "workspace:*",
    "@scalar/fastify-api-reference": "^1.43.17",
    "@sentry/node": "^10.56.0",
    "abacatepay-nodejs-sdk": "^1.6.0",
    "better-auth": "^1.5.4",
    "close-with-grace": "^2.4.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "i18next": "^24.2.0",
    "ioredis": "5.10.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/node": "^20.18.0",
    "pino-pretty": "^13.1.3",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.19.1",
    "typescript": "5.5.4",
    "vitest": "^3.2.4"
  }
}
