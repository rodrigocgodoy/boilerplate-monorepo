# Copie para .env e ajuste os valores: cp .env.example .env

# ── Ambiente ──────────────────────────────────────────────
ENV=development
API_LOG_LEVEL=info

# ── API (Fastify + Better Auth) ───────────────────────────
PORT=3333
HOST=0.0.0.0
# Gere segredos com: openssl rand -base64 32
COOKIE_SECRET=troque-este-cookie-secret
BETTER_AUTH_SECRET=troque-este-better-auth-secret
BETTER_AUTH_URL=http://localhost:3333
APP_URL=http://localhost:5173

# ── Frontend (app Vite) ───────────────────────────────────
VITE_API_URL=http://localhost:3333
APP_PORT=5173

# ── Banco de dados (Postgres via docker-compose) ──────────
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=boilerplate
DB_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/boilerplate?schema=public

# ── Google OAuth (opcional) ───────────────────────────────
# Deixe vazio para usar só email/senha. Para habilitar login com Google,
# crie credenciais OAuth (ver UPGRADES.md) e preencha abaixo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Upgrades opcionais (ver UPGRADES.md) ──────────────────
# REDIS_URL=redis://localhost:6379
# REDIS_PORT=6379
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=boilerplate
# S3_REGION=auto
# S3_PUBLIC_URL=http://localhost:9000/boilerplate
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001
