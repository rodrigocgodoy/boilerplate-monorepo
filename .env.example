# Copie para .env e ajuste os valores: cp .env.example .env

# ── Ambiente ──────────────────────────────────────────────
ENV=development
# NODE_ENV precisa acompanhar o ENV em produção: bibliotecas de terceiros
# decidem o modo por ele. Em especial, o rate limit do Better Auth (3 tentativas
# de login por 10s) SÓ liga com NODE_ENV=production. A API recusa subir se
# ENV=production e NODE_ENV não for.
NODE_ENV=development
API_LOG_LEVEL=info

# ── API (Fastify + Better Auth) ───────────────────────────
PORT=3333
HOST=0.0.0.0
# Gere segredos com: openssl rand -base64 32
COOKIE_SECRET=troque-este-cookie-secret
BETTER_AUTH_SECRET=troque-este-better-auth-secret
BETTER_AUTH_URL=http://localhost:3333
APP_URL=http://localhost:5173

# ── Frontend (app Vite) ───────────────────────────────────
VITE_API_URL=http://localhost:3333
APP_PORT=5173

# ── Banco de dados (Postgres via docker-compose) ──────────
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=boilerplate
DB_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/boilerplate?schema=public

# ── RBAC de plataforma / painel admin (opcional) ──────────
# Lista de e-mails que viram super-admin (role de sistema `admin` do plugin
# admin do Better Auth): promovidos no signup e sincronizados no login. Dá
# acesso ao painel /admin (gestão de usuários, ban, impersonation). Separe por
# vírgula. Vazio = nenhum admin automático. Ver UPGRADES.md.
ADMIN_EMAILS=

# ── Google OAuth (opcional) ───────────────────────────────
# Deixe vazio para usar só email/senha. Para habilitar login com Google,
# crie credenciais OAuth (ver UPGRADES.md) e preencha abaixo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── E-mail transacional (Resend, opcional) ────────────────
# Vazio = e-mails são logados no console (dev). Pegue a key em resend.com e use
# um remetente de domínio verificado em produção (ver UPGRADES.md).
RESEND_API_KEY=
EMAIL_FROM="Boilerplate <onboarding@resend.dev>"

# ── AbacatePay (pagamentos, opcional) ─────────────────────
# Deixe vazio para desabilitar. Pegue a API key em https://abacatepay.com
# (use a key de devMode para testes). ABACATEPAY_WEBHOOK_SECRET é o segredo
# que você define no painel e que chega como ?webhookSecret=... no webhook.
# ABACATEPAY_WEBHOOK_PUBLIC_KEY: deixe vazio para usar a chave pública padrão
# do AbacatePay (usada para validar o header X-Webhook-Signature via HMAC).
ABACATEPAY_API_KEY=
ABACATEPAY_WEBHOOK_SECRET=
ABACATEPAY_WEBHOOK_PUBLIC_KEY=
# Bloqueio de features por plano. false = nada bloqueado (no-op no server e no
# front). true = rotas guardadas exigem plano ativo (server 402; front redireciona).
REQUIRE_ACTIVE_PLAN=false

# ── Jobs em background (BullMQ + Redis, opcional) ─────────
# Vazio = jobs rodam inline (síncrono, sem fila) — ok para dev. Preencha para
# ativar a fila/worker/agendador (suba o Redis com `pnpm dep-up`).
REDIS_URL=
REDIS_PORT=6379
# Sobe o worker junto da API (in-process). false = só enfileira; rode o worker
# separado com `pnpm worker`. Ver UPGRADES.md.
JOBS_IN_PROCESS=true
# Quanto o worker espera o job em andamento terminar antes de ser morto à força
# (ms). Precisa ser maior que o job mais lento que você tolera perder no meio.
# Deixe abaixo do limite do seu orquestrador — no Kubernetes, o padrão de
# `terminationGracePeriodSeconds` é 30s.
JOBS_SHUTDOWN_TIMEOUT_MS=30000

# ── Segurança ─────────────────────────────────────────────
# Origens autorizadas no CORS, separadas por vírgula. Vazio = usa só o APP_URL.
# NUNCA use `*` nem refletir a origem da requisição: com cookies de sessão isso
# autoriza qualquer site a chamar a API como se fosse o usuário logado.
CORS_ORIGINS=
# Teto do rate limit por IP nas rotas da API (req/min). As rotas de auth têm
# limites próprios e mais restritos (Better Auth); o webhook é folgado e o
# export LGPD é apertado — ver apps/api/src/utils/rate-limit.ts.
RATE_LIMIT_MAX=100

# ── Upload de arquivos (S3/MinIO, opcional) ───────────────
# Sem S3_BUCKET + credenciais, POST /uploads/avatar responde 503. Deixe
# S3_ENDPOINT vazio para AWS S3; preencha para MinIO/R2. Ver UPGRADES.md.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=auto
# Base pública dos objetos (usada para montar a URL do avatar).
S3_PUBLIC_URL=
# Tamanho máximo do avatar, em bytes (default 2 MB).
AVATAR_MAX_BYTES=2097152

# ── Observabilidade (Sentry, opcional) ───────────────────
# Vazio = desligado (no-op): nada é capturado/enviado. Preencha o DSN do seu
# projeto Sentry para capturar erros e traces (server e app). Ver UPGRADES.md.
SENTRY_DSN=
# Ambiente reportado (vazio = usa ENV). Amostragem de traces 0..1 (0 = só erros).
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0
# Frontend (Vite expõe só VITE_*). DSN separado do projeto web no Sentry.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_TRACES_SAMPLE_RATE=0

# ── Product analytics + feature flags (PostHog, opcional) ─
# Frontend (Vite expõe só VITE_*). Vazio = desligado (no-op). Pegue a Project
# API Key no PostHog. Host: US (padrão) ou https://eu.i.posthog.com. Ver
# UPGRADES.md.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ── Upload de arquivos (S3/MinIO, opcional — #14) ─────────
# Vazio = uploads desligados (rota responde 503). Para MinIO local: descomente
# o serviço no docker-compose.yml e o bloco abaixo. Ver UPGRADES.md → MinIO/S3.
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=boilerplate
# S3_REGION=auto
# S3_PUBLIC_URL=http://localhost:9000/boilerplate
# AVATAR_MAX_BYTES=2097152
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001
